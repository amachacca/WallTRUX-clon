{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WallTRUX Studio",
  "version": "0.1.0",
  "identifier": "com.walltrux.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "WallTRUX Studio",
      "width": 1428,
      "height": 853,
      "minWidth": 900,
      "minHeight": 620,
      "center": true,
      "backgroundColor": "#eef4fc"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Editor y motor local de interacción de concreto armado",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}
